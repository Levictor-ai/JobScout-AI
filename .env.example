# JobScout AI Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses row level security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Set to "true" to show the registration form on /login.
# Anything else keeps registration closed, and signUpAction refuses direct POSTs.
ALLOW_SIGNUP=false

# Shared secret for POST /api/ingest, POST /api/analyze and POST /api/notifications/telegram.
# Send it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# OpenAI API (Job Classification, Skill Extraction, Match Reasoning)
OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Telegram Bot (Instant Job Match Alerts) - server only, never exposed to the client
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
